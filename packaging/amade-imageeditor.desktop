Exec=/usr/bin/amade-imageeditor %f
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;Photography;
MimeType=image/jpeg;image/png;image/gif;image/bmp;image/x-bmp;image/tiff;image/webp;image/x-portable-anymap;image/x-portable-pixmap;image/x-portable-graymap;image/x-portable-bitmap;image/x-tga;image/vnd.adobe.photoshop;image/x-psd;image/x-iff;image/x-pict;image/x-sgi;image/x-icns;image/openraster;
Keywords=image;picture;photo;editor;crop;rotate;straighten;resize;brightness;contrast;paint;draw;text;layers;arrow;openraster;malen;Ebenen;Bild;Foto;zuschneiden;drehen;
