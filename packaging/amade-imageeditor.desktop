[Desktop Entry]
Type=Application
Version=1.0
Name=amadeOS Image Editor
Name[de]=amadeOS Bildbearbeitung
Name[fr]=amadeOS Éditeur d'images
Name[es]=amadeOS Editor de imágenes
Name[it]=amadeOS Editor di immagini
GenericName=Image Editor
GenericName[de]=Bildbearbeitung
GenericName[fr]=Éditeur d'images
GenericName[es]=Editor de imágenes
GenericName[it]=Editor di immagini
Comment=Crop, straighten, resize and adjust photos
Comment[de]=Fotos zuschneiden, begradigen, verkleinern und anpassen
Comment[fr]=Recadrer, redresser, redimensionner et ajuster des photos
Comment[es]=Recortar, enderezar, redimensionar y ajustar fotos
Comment[it]=Ritagliare, raddrizzare, ridimensionare e regolare foto
Icon=amade-imageeditor
Exec=/usr/bin/amade-imageeditor %f
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;Photography;
MimeType=image/jpeg;image/png;image/gif;image/bmp;image/x-bmp;image/tiff;image/webp;image/x-portable-anymap;image/x-portable-pixmap;image/x-portable-graymap;image/x-portable-bitmap;image/x-tga;image/vnd.adobe.photoshop;image/x-psd;image/x-iff;image/x-pict;image/x-sgi;image/x-icns;
Keywords=image;picture;photo;editor;crop;rotate;straighten;resize;brightness;contrast;Bild;Foto;zuschneiden;drehen;
StartupNotify=true
